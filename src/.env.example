# Copiar a .env y ajustar según el entorno.
# Credenciales de PostgreSQL
POSTGRES_USER=eventsapp
POSTGRES_PASSWORD=eventsapp
POSTGRES_DB=eventsapp
POSTGRES_PORT=5432

# Puerto expuesto por el microservicio de autenticación
AUTH_SERVICE_PORT=5000

# Secreto de firma de la credencial de sesión (JWT). Obligatorio.
# Este valor solo vale para desarrollo local; en cualquier otro entorno genera
# uno propio, por ejemplo con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-jwt-secret
